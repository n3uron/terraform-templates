# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform variable files (often contain secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example
!**/tests/*.tfvars
**/tests/secrets.tfvars

# Terraform plan output files
*.tfplan
plan.out

# CLI configuration files
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive outputs / local env files
*.auto.tfvars
*.auto.tfvars.json
.env
.env.*

# OS/editor noise
.DS_Store
Thumbs.db
.claude/
.vscode/settings.json
